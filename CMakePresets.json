{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "gui",
      "displayName": "Release + live viewer (raylib)",
      "binaryDir": "${sourceDir}/build/gui",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CRISTAL_GUI": "ON" }
    },
    {
      "name": "sanitize",
      "displayName": "Debug + Sanitizer (GCC/Clang, not MinGW)",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CRISTAL_SANITIZE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "gui", "configurePreset": "gui", "configuration": "Release" },
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
